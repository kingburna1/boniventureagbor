# ==========================================
# DATABASE (Prisma & PostgreSQL / Supabase)
# ==========================================
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# ==========================================
# ADMIN AUTHENTICATION
# ==========================================
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="SecureAdminPasswordHere"
JWT_SECRET="your-32-byte-hex-secret-key-here"

# ==========================================
# GOOGLE DRIVE CLOUD STORAGE (Service Account)
# ==========================================
GOOGLE_PROJECT_ID="your-gcp-project-id"
GOOGLE_CLIENT_EMAIL="service-account-name@your-project.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_RSA_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_FOLDER_ID="your-google-drive-folder-id"

# ==========================================
# CONTACT FORM & EMAIL DISPATCH (Nodemailer)
# ==========================================
EMAIL_SERVER_HOST="smtp.gmail.com"
EMAIL_SERVER_PORT=465
EMAIL_SERVER_USER="your-email@gmail.com"
EMAIL_SERVER_PASSWORD="your-app-password"
EMAIL_FROM="your-email@gmail.com"

# ==========================================
# SITE METADATA
# ==========================================
NEXT_PUBLIC_SITE_URL="https://boniventure.dev"
